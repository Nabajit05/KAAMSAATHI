# HaqCheck environment variables. Copy to .env.local and fill in real values.
# Names and explanations only; never commit real values.
# The demo (/demo) works with none of these set.

# ---------------------------------------------------------------------------
# PUBLIC (exposed to the browser; safe to expose by design, protected by RLS)
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://<project-ref>.supabase.co
# Also used by next.config.ts to allow this origin in the CSP (img-src, connect-src).
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable (anon) key. Public by design; row-level security protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy name, used only if the publishable key above is not set:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# SERVER SECRETS (never expose to the browser; never prefix with NEXT_PUBLIC_)
# ---------------------------------------------------------------------------

# Supabase service-role key. Bypasses RLS. Used ONLY by DELETE /api/account to
# remove the auth user. If unset, account deletion reports "not configured".
SUPABASE_SERVICE_ROLE_KEY=

# Gemini API key. Enables live evidence extraction, AI complaint drafting and
# the demo's "Read the sample live with AI". If unset, the demo shows recorded
# results and complaints use the "Standard factual draft" template.
GEMINI_API_KEY=

# Gemini model id. Default: gemini-3.8-flash (verified 2026-10-17 against the
# official models page). Re-verify before changing.
GEMINI_MODEL=

# Voice input (speech-to-text) and "Listen" (text-to-speech) also use GEMINI_API_KEY.
# Gemini TTS model. Default: gemini-3.8-flash-tts
GEMINI_TTS_MODEL=

# Gemini TTS prebuilt voice. Default: Kore
GEMINI_TTS_VOICE=

# Sign-in method: "email" (magic link; works on Supabase free tier) or "phone" (SMS OTP; needs Twilio etc.)
NEXT_PUBLIC_AUTH_METHOD=email

# Supabase personal access token. Only for applying migrations from your machine; never deployed.
SUPABASE_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# SERVER TUNING (optional; numbers; defaults in src/server/config.ts)
# ---------------------------------------------------------------------------

# Per-user caps on billed AI operations in a rolling 24 hours. Default 20.
DAILY_EXTRACT_LIMIT=
# Default 20.
DAILY_DRAFT_LIMIT=
# Shared cap for speech-to-text and text-to-speech per user. Default 30.
DAILY_SPEECH_LIMIT=

# Cap on unauthenticated demo AI drafts per server instance per day. Default 200.
# After the cap the demo returns the template draft instead of calling Gemini.
DEMO_DAILY_LIMIT=

# Timeout for each provider call, in milliseconds. Default 25000.
# The host's function timeout must be longer than this (see README).
AI_TIMEOUT_MS=
